{
  // Hand-written docs only; the generated ones come from packages/okb/src/gendocs.ts and packages/okb/examples/build-wine.ts.
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**", ".github/pull_request_template.md", "site/dist/**", "site/.astro/**",
    "docs/METHOD.md", "docs/GLOSSARY.md", "docs/RULES.md", "docs/DECISIONS.md", "docs/CLI.md", "docs/CLI-CHEAT-SHEET.md",
    "packages/okb/examples/wine/*.md", "packages/okb/examples/wine/tutorial/**", "packages/okb/tests/fixtures/**", ".vale/styles/Google/**", ".vale/styles/write-good/**"
  ],
  "config": {
    "default": true,
    // Long lines are fine: tables and one-sentence-per-line prose would fight a length limit.
    "MD013": false,
    // Inline HTML is used on purpose (<details>, anchors).
    "MD033": false,
    // Prettier owns list and emphasis style; don't second-guess it.
    "MD004": false, "MD049": false, "MD050": false, "MD060": false
  }
}
