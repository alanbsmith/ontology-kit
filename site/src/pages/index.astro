---
// A placeholder home page until the landing page (#43) replaces it.
import Base from '../layouts/Base.astro';
---

<Base>
	<main id="main" class="home">
		<h1>Ontology Kit</h1>
		<p>Turn your team's docs into a structured, sourced knowledge base.</p>
		<p><a href="/getting-started/">Get started</a></p>
	</main>
</Base>

<style>
	.home {
		flex: 1;
		width: 100%;
		max-width: var(--measure);
		margin-inline: auto;
		padding: var(--space-2xl) var(--space-gutter);
	}
</style>
