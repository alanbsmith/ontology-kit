---
// A plain band at the foot of every page. The blog's footer (art, social links) is blog-only.
const REPO = 'https://github.com/alanbsmith/ontology-kit';
---

<footer>
	<div class="inner">
		<p><strong>Ontology Kit</strong> <span class="muted">· a guided way to build your first ontology</span></p>
		<a href={REPO}>Source on GitHub</a>
	</div>
</footer>

<style>
	footer {
		background: var(--color-surface-raised);
		border-top: var(--border-width) solid var(--color-border);
		font-size: var(--text-small);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-xs) var(--space-md);
		max-width: calc(var(--width-page) + 2 * var(--space-gutter));
		margin-inline: auto;
		padding: var(--space-lg) var(--space-gutter);
	}

	p {
		margin: 0;
	}
</style>
