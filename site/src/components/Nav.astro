---
// Adapted from the owner's blog (~/Projects/writing/src/components/Nav.astro). Kept as is: the
// floating pill, the reading-settings panel, the contents sheet and the phone behavior. Added for
// the docs: a menu sheet with the sidebar (below 64rem), and Pagefind search.
import Sidebar from './Sidebar.astro';
import { outlineItems, type Heading } from '../lib/outline';
import { sidebar } from '../nav.ts';
import { metaNodes } from '../lib/meta.ts';

interface Props {
	/** An article's headings. With two or more, the nav gets a contents button and sheet. */
	outline?: Heading[];
}
const toc = outlineItems(Astro.props.outline);
const hasContents = toc.length >= 2;
const navGroups = sidebar(metaNodes);
const current = Astro.url.pathname.replace(/\/?$/, '/');

// Reading settings. `value` is what lands on <html data-*>; 'system' / 'sans' / 'default' mean none.
const groups = [
	{
		name: 'theme',
		legend: 'Theme',
		options: [
			{ value: 'system', label: 'System' },
			{ value: 'light', label: 'Light' },
			{ value: 'dark', label: 'Dark' },
		],
	},
	{
		name: 'vision',
		legend: 'Color vision',
		hint: 'Uses colors that stay distinct for color blindness.',
		options: [
			{ value: 'default', label: 'Standard' },
			{ value: 'redgreen', label: 'Red-green' },
			{ value: 'blueyellow', label: 'Blue-yellow' },
		],
	},
	{
		name: 'font',
		legend: 'Font',
		options: [
			{ value: 'sans', label: 'Sans' },
			{ value: 'serif', label: 'Serif' },
			{ value: 'dyslexic', label: 'Open Dyslexic' },
		],
	},
	{
		name: 'size',
		legend: 'Text size',
		options: [
			{ value: 'default', label: 'Default' },
			{ value: 'large', label: 'Large' },
			{ value: 'larger', label: 'Larger' },
		],
	},
] as const;

// Radio groups render before and after the contrast switch, so the panel reads:
// theme, color vision, contrast, font, text size.
const beforeSwitch = groups.filter((g) => g.name === 'theme' || g.name === 'vision');
const afterSwitch = groups.filter((g) => g.name === 'font' || g.name === 'size');
---

<div class="nav-wrap" data-contents={hasContents ? '' : undefined}>
	<!-- The site menu: its own circle at the left of the bar, like "Aa" at the right. -->
	<button type="button" class="settings-button" popovertarget="menu-sheet" aria-label="Menu">
		<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false">
			<rect x="3" y="4.5" width="18" height="15" rx="3" />
			<path d="M9 4.5v15" />
		</svg>
	</button>
	<nav class="nav" aria-label="Primary">
		<a href="/" class="brand" aria-label="Ontology Kit, home">
			<img src="/favicon.svg" width="24" height="24" alt="" />
			<span>Ontology Kit</span>
		</a>
		<ul>
			<li>
				<button type="button" class="pill-button search-button" popovertarget="search-sheet" aria-label="Search" aria-keyshortcuts="/">
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false">
						<circle cx="11" cy="11" r="6.5" />
						<path d="M16 16l4.5 4.5" />
					</svg>
				</button>
			</li>
		</ul>
	</nav>
	{
		hasContents && (
			<button type="button" class="settings-button contents-button" popovertarget="contents-sheet" aria-label="Contents">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false">
					<path d="M4 7h16M4 12h16M4 17h10" />
				</svg>
			</button>
		)
	}
	<button type="button" class="settings-button" popovertarget="reading-settings" aria-label="Reading settings">
		<span aria-hidden="true">Aa</span>
	</button>

	{
		hasContents && (
			<div id="contents-sheet" class="panel contents-panel" popover>
				<div class="panel-head">
					<h2 class="panel-title">On this page</h2>
					<button type="button" class="done" popovertarget="contents-sheet" popovertargetaction="hide" aria-label="Close contents"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
				</div>
				<nav aria-label="Contents">
					<ul class="toc" data-spy>
						{toc.map((h) => (
							<li class={h.depth === 3 ? 'sub' : undefined}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ul>
				</nav>
				<a class="sheet-top" href="#top">
					<span>Back to top</span>
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
						<circle cx="12" cy="12" r="10"></circle>
						<path d="M8 14.5l4-4 4 4"></path>
					</svg>
				</a>
			</div>
		)
	}

	<div id="menu-sheet" class="panel menu-panel" popover>
		<div class="panel-head">
			<h2 class="panel-title">Browse the docs</h2>
			<button type="button" class="done" autofocus popovertarget="menu-sheet" popovertargetaction="hide" aria-label="Close menu"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
		</div>
		<nav aria-label="Docs">
			<Sidebar groups={navGroups} current={current} />
		</nav>
	</div>

	<div id="search-sheet" class="panel search-panel" popover>
		<div class="panel-head">
			<h2 class="panel-title">Search the docs</h2>
			<button type="button" class="done" popovertarget="search-sheet" popovertargetaction="hide" aria-label="Close search"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
		</div>
		<div id="search-ui" role="search"></div>
		<p class="hint" data-search-unavailable hidden>Search works on the built site: run <code>pnpm site</code>, then <code>pnpm --dir site preview</code>.</p>
	</div>

	<div id="reading-settings" class="panel" popover>
		<form>
			<div class="panel-head">
				<h2 class="panel-title">Reading settings</h2>
				<button type="button" class="done" popovertarget="reading-settings" popovertargetaction="hide" aria-label="Close reading settings"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
			</div>
			{
				beforeSwitch.map((group) => (
					<fieldset>
						<legend>{group.legend}</legend>
						{'hint' in group && <p class="hint">{group.hint}</p>}
						<div class="options">
							{group.options.map((option) => (
								<label>
									<input type="radio" name={group.name} value={option.value} />
									<span>{option.label}</span>
								</label>
							))}
						</div>
					</fieldset>
				))
			}
			<label class="switch">
				<span class="switch-text">
					<span class="switch-title">High contrast</span>
					<span class="hint">Stronger text, borders and links. Follows your system.</span>
				</span>
				<input type="checkbox" role="switch" name="contrast" />
				<span class="track" aria-hidden="true"></span>
			</label>
			{
				afterSwitch.map((group) => (
					<fieldset>
						<legend>{group.legend}</legend>
						<div class="options">
							{group.options.map((option) => (
								<label>
									<input type="radio" name={group.name} value={option.value} />
									<span>{option.label}</span>
								</label>
							))}
						</div>
					</fieldset>
				))
			}
		</form>
	</div>
</div>

<script>
	// Reads and writes the same keys as the inline script in <head> (see Base.astro).
	const KEY = 'reading-prefs';
	const defaults = { theme: 'system', font: 'sans', size: 'default', vision: 'default', contrast: 'auto' } as const;
	type Prefs = Record<keyof typeof defaults, string>;

	const load = (): Prefs => {
		try {
			return { ...defaults, ...JSON.parse(localStorage.getItem(KEY) ?? '{}') };
		} catch {
			return { ...defaults };
		}
	};

	// 'auto' follows the system's contrast preference; 'more' and 'off' are explicit choices.
	const systemContrast = () => matchMedia('(prefers-contrast: more)').matches;
	const contrastOn = (prefs: Prefs) => (prefs.contrast === 'auto' ? systemContrast() : prefs.contrast === 'more');

	const apply = (prefs: Prefs) => {
		const root = document.documentElement;
		const set = (attr: string, value: string, none: string) =>
			value === none ? delete root.dataset[attr] : (root.dataset[attr] = value);
		set('theme', prefs.theme, 'system');
		set('font', prefs.font, 'sans');
		set('size', prefs.size, 'default');
		set('vision', prefs.vision, 'default');
		if (contrastOn(prefs)) root.dataset.contrast = 'more';
		else delete root.dataset.contrast;
	};

	// On phones the bar slides out of the way while the page scrolls and comes back shortly after
	// it stops. This only marks the page; the sliding is CSS (see .nav-wrap). To keep a small
	// nudge from making it jump, the bar hides only once a scroll has both carried on for
	// HIDE_AFTER ms and covered HIDE_DISTANCE px. Scroll events keep firing through iOS momentum
	// scrolling, so "stopped" means the page really has stopped.
	{
		const HIDE_AFTER = 150; // ms of continuous scrolling
		const HIDE_DISTANCE = 64; // px travelled in that scroll
		const SHOW_AFTER = 200; // ms without scrolling before the bar comes back
		const phone = matchMedia('(max-width: 47.99rem)');
		const root = document.documentElement;
		let startedAt = 0;
		let startedY = 0;
		let timer: number | undefined;
		addEventListener(
			'scroll',
			() => {
				if (!phone.matches) return;
				const now = performance.now();
				if (!startedAt) {
					startedAt = now;
					startedY = scrollY;
				}
				if (now - startedAt >= HIDE_AFTER && Math.abs(scrollY - startedY) >= HIDE_DISTANCE) {
					root.dataset.scrolling = '';
				}
				clearTimeout(timer);
				timer = window.setTimeout(() => {
					delete root.dataset.scrolling;
					startedAt = 0;
				}, SHOW_AFTER);
			},
			{ passive: true },
		);
	}

	// The contents sheet closes as soon as a section (or "Back to top") is chosen, so the page it
	// scrolls to is not hidden behind it. The current section is scrolled into view when it opens.
	const sheet = document.querySelector<HTMLElement>('#contents-sheet');
	if (sheet) {
		sheet.addEventListener('click', (event) => {
			const link = (event.target as Element).closest('a');
			if (!link) return;
			sheet.hidePopover();
			if (link.hash === '#top') {
				setTimeout(() => history.replaceState(null, '', location.pathname + location.search), 0);
			}
		});
		sheet.addEventListener('toggle', (event) => {
			if ((event as ToggleEvent).newState !== 'open') return;
			sheet.querySelector('[aria-current]')?.scrollIntoView({ block: 'center' });
		});
	}

	// The menu sheet closes once a link is chosen, so a same-page link (a step, a decision guide)
	// is not hidden behind it.
	const menu = document.querySelector<HTMLElement>('#menu-sheet');
	menu?.addEventListener('click', (event) => {
		if ((event.target as Element).closest('a')) menu.hidePopover();
	});

	// Pagefind writes its index and UI into dist/pagefind/ after `astro build`, so the UI loads
	// the first time search opens, and not at all on pages where nobody searches. Under
	// `astro dev` there is no index; the sheet says so.
	const search = document.querySelector<HTMLElement>('#search-sheet');
	if (search) {
		let loaded: Promise<void> | undefined;
		const load = () =>
			(loaded ??= new Promise<void>((resolve, reject) => {
				const css = document.createElement('link');
				css.rel = 'stylesheet';
				css.href = '/pagefind/pagefind-ui.css';
				document.head.append(css);
				const js = document.createElement('script');
				js.src = '/pagefind/pagefind-ui.js';
				js.onload = () => resolve();
				js.onerror = () => reject(new Error('Pagefind is not built'));
				document.head.append(js);
			}).then(() => {
				const { PagefindUI } = window as unknown as { PagefindUI: new (options: object) => unknown };
				new PagefindUI({ element: '#search-ui', showSubResults: true, showImages: false, resetStyles: false });
			}));
		search.addEventListener('toggle', async (event) => {
			if ((event as ToggleEvent).newState !== 'open') return;
			try {
				await load();
				search.querySelector<HTMLInputElement>('input')?.focus();
			} catch {
				search.querySelector<HTMLElement>('[data-search-unavailable]')!.hidden = false;
			}
		});
		search.addEventListener('click', (event) => {
			const link = (event.target as Element).closest('a');
			if (link && link.pathname === location.pathname) search.hidePopover();
		});
		// "/" opens search, as on most docs sites, unless you are typing somewhere.
		addEventListener('keydown', (event) => {
			if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
			const target = event.target as HTMLElement;
			if (target.closest('input, textarea, select, [contenteditable]')) return;
			event.preventDefault();
			search.showPopover();
		});
	}

	const form = document.querySelector<HTMLFormElement>('#reading-settings form');
	if (form) {
		const prefs = load();
		for (const [name, value] of Object.entries(prefs)) {
			if (name === 'contrast') continue;
			const radio = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
			if (radio) radio.checked = true;
		}

		const toggle = form.querySelector<HTMLInputElement>('input[name="contrast"]');
		if (toggle) toggle.checked = contrastOn(prefs);

		form.addEventListener('change', (event) => {
			const input = event.target as HTMLInputElement;
			if (input.name === 'contrast') {
				prefs.contrast = input.checked ? 'more' : 'off';
			} else {
				prefs[input.name as keyof Prefs] = input.value;
			}
			apply(prefs);
			try {
				localStorage.setItem(KEY, JSON.stringify(prefs));
			} catch {
				// Storage can be blocked. The setting still applies for this page view.
			}
		});
	}
</script>

<style>
	/* Wide screens: sticks to the top and floats OVER the page (zero height, so it reserves no
	   row of dead space). Narrow screens: fixed to the bottom, in thumb reach. */
	.nav-wrap {
		position: sticky;
		top: 0;
		z-index: 10;
		height: 0;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		gap: var(--space-xs);
		padding-inline: var(--space-sm);
		pointer-events: none;
	}

	@media (max-width: 47.99rem) {
		.nav-wrap {
			position: fixed;
			inset: auto 0 0 0;
			top: auto;
			height: auto;
			align-items: stretch;
			padding: 0 var(--space-sm) max(var(--space-sm), env(safe-area-inset-bottom));
		}
	}

	/* Phones, when motion is allowed: slide the bar off the bottom edge while scrolling. It stays
	   put when something inside it has focus, so keyboard and screen reader users never lose it.
	   People who ask for reduced motion keep it in place. */
	@media (max-width: 47.99rem) and (prefers-reduced-motion: no-preference) {
		.nav-wrap {
			transition: translate var(--duration) var(--ease-out);
		}

		:global(html[data-scrolling]) .nav-wrap:not(:focus-within) {
			translate: 0 calc(100% + 1rem);
		}
	}

	/* Frosted glass: a mostly opaque surface over a blur of whatever scrolls behind it, so the
	   labels stay readable over busy art. The edge is brighter than a normal border, with a faint
	   highlight along the top, so the shape holds even over a plain page. */
	.nav,
	.settings-button {
		margin-top: var(--space-sm);
		pointer-events: auto;
		background: color-mix(in oklab, var(--color-surface-raised) 78%, transparent);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		backdrop-filter: blur(16px) saturate(1.4);
		border: var(--border-width) solid color-mix(in oklab, var(--color-border-strong) 70%, transparent);
		box-shadow:
			var(--shadow-floating),
			inset 0 1px 0 light-dark(oklch(1 0 0 / 0.7), oklch(1 0 0 / 0.08));
	}

	/* Solid where blur is unavailable, where the system asks for less transparency, and in high
	   contrast, where text must never sit on a see-through surface. */
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.nav,
		.settings-button {
			background: var(--color-surface-raised);
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.nav,
		.settings-button {
			background: var(--color-surface-raised);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}

	:global(:root[data-contrast='more']) .nav,
	:global(:root[data-contrast='more']) .settings-button {
		background: var(--color-surface-raised);
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
		border-color: var(--color-border);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		padding: var(--space-tight);
		border-radius: var(--radius-full);
		font-size: var(--text-small);
	}

	/* A round companion to the pill. Same height as the pill: 44px target plus its padding. */
	.settings-button {
		display: grid;
		place-items: center;
		flex: none;
		aspect-ratio: 1;
		min-width: 3.5rem;
		padding: 0;
		border-radius: var(--radius-full);
		color: var(--color-text);
		font: inherit;
		font-size: var(--text-small);
		font-weight: var(--weight-strong);
		cursor: pointer;
	}

	.settings-button:hover,
	.settings-button:where(:popover-open, [aria-expanded='true']) {
		background: var(--color-surface);
	}

	ul {
		display: flex;
		gap: var(--space-tight);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 47.99rem) {
		.nav,
		.settings-button {
			margin-top: 0;
		}
	}

	.brand,
	li a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		min-height: 2.75rem;
		padding-inline: var(--space-sm);
		border-radius: var(--radius-full);
		color: var(--color-text);
		text-decoration: none;
	}

	.brand {
		font-weight: var(--weight-strong);
		padding-inline-start: var(--space-sm);
	}

	.brand:hover,
	li a:hover {
		background: var(--color-surface);
		color: var(--color-text);
	}

	li a[aria-current='page'] {
		background: var(--color-surface);
		font-weight: var(--weight-strong);
	}

	/* ---------- Settings panel (a native popover: Escape and outside click close it) ---------- */

	.panel {
		/* Undo the popover's default centering, then place it under the nav on wide screens. */
		inset: auto;
		margin: 0;
		position: fixed;
		top: 5.5rem;
		left: 50%;
		translate: -50% 0;
		width: min(24rem, calc(100vw - 2 * var(--space-sm)));
		padding: var(--space-md);
		color: var(--color-text);
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-floating), inset 0 0 0 calc(var(--border-width) - 1px) var(--color-border);
		pointer-events: auto;
		/* Five groups are tall on a phone: scroll inside the panel instead of off the screen. */
		max-height: calc(100dvh - 8rem);
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	/* Fades and rises a few pixels on open, and reverses on close. `display` and `overlay` are
	   transitioned too, so the popover stays on screen until the exit finishes. Browsers that
	   cannot do this just open and close instantly. */
	@media (prefers-reduced-motion: no-preference) {
		.panel {
			transition:
				opacity var(--duration) var(--ease-out),
				translate var(--duration) var(--ease-out),
				overlay var(--duration) allow-discrete,
				display var(--duration) allow-discrete;
		}

		.panel:not(:popover-open) {
			opacity: 0;
			translate: -50% 0.5rem;
		}

		@starting-style {
			.panel:popover-open {
				opacity: 0;
				translate: -50% 0.5rem;
			}
		}
	}

	/* A popover that is not open takes no clicks, even while its exit transition is still playing.
	   Never set `display` on `.panel`: it would override the browser's own display: none for closed
	   popovers and leave an invisible panel sitting over the page. */
	.panel:not(:popover-open) {
		pointer-events: none;
	}

	/* Phones: a bottom sheet. It rises from the bottom edge over a dimmed page, takes the full
	   width, and scrolls inside if the screen is short. The close button, a tap outside, or Escape closes it. */
	@media (max-width: 47.99rem) {
		.panel {
			inset: auto 0 0 0;
			translate: 0 0;
			width: auto;
			max-height: min(90dvh, 40rem);
			padding: var(--space-sm) var(--space-md) max(var(--space-md), env(safe-area-inset-bottom));
			border-bottom: 0;
			border-radius: var(--radius-lg) var(--radius-lg) 0 0;
			box-shadow: none;
		}

		.panel::backdrop {
			background: light-dark(oklch(0.2 0.03 260 / 0.35), oklch(0 0 0 / 0.55));
		}

		/* The page behind should not scroll while the sheet is up. */
		:global(html:has(.panel:popover-open)) {
			overflow: hidden;
		}

		.panel form {
			gap: var(--space-sm);
		}
	}

	@media (prefers-reduced-motion: no-preference) and (max-width: 47.99rem) {
		.panel:not(:popover-open) {
			opacity: 1;
			translate: 0 100%;
		}

		@starting-style {
			.panel:popover-open {
				opacity: 1;
				translate: 0 100%;
			}
		}

		.panel::backdrop {
			transition:
				background-color var(--duration) var(--ease-out),
				overlay var(--duration) allow-discrete,
				display var(--duration) allow-discrete;
		}

		.panel:not(:popover-open)::backdrop {
			background-color: transparent;
		}

		@starting-style {
			.panel:popover-open::backdrop {
				background-color: transparent;
			}
		}
