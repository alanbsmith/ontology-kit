{
  "name": "ontology-kit-workspace",
  "version": "1.0.0",
  "license": "MIT",
  "description": "The Ontology Kit repository: a pnpm workspace holding the okb package (packages/okb) and the docs site (site), plus repo-wide docs tooling.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "okb": "node packages/okb/src/cli.ts",
    "build": "pnpm --filter @ontology-kit/okb run build",
    "build:meta": "pnpm --filter @ontology-kit/okb run build:meta",
    "verify:quotes": "pnpm --filter @ontology-kit/okb run verify:quotes",
    "docs": "pnpm --filter @ontology-kit/okb run docs",
    "example": "pnpm --filter @ontology-kit/okb run example",
    "site": "pnpm run docs && pnpm example && pnpm --filter ontology-kit-docs run build",
    "site:dev": "pnpm run docs && pnpm example && pnpm --filter ontology-kit-docs run dev",
    "tsc": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format:docs": "prettier --write \"**/*.md\"",
    "lint:docs": "prettier --check \"**/*.md\" && markdownlint-cli2 && scripts/vale.sh"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "yaml": "^2.8.0"
  }
}
