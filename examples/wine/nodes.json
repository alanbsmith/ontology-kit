  {
    "type": "Class",
    "id": "c.wine",
    "name": "Wine",
    "description": "A specific wine produced by a specific winery (not an individual bottle).",
    "defaults": {
      "s.body": "medium"
    }
  },
  {
    "type": "Class",
    "id": "c.red-wine",
    "name": "RedWine",
    "description": "Wine made from dark-skinned grapes with skin contact; described by tannin level.",
    "fixedValues": {
      "s.color": "red"
    }
  },
  {
    "type": "Class",
    "id": "c.white-wine",
    "name": "WhiteWine",
    "description": "Wine fermented without grape skins.",
    "fixedValues": {
      "s.color": "white"
    }
  },
  {
    "type": "Class",
    "id": "c.rose-wine",
    "name": "RoseWine",
    "description": "Wine with brief skin contact giving a pink color.",
    "synonyms": [
      "Rosé"
    ],
    "fixedValues": {
      "s.color": "rose"
    }
  },
  {
    "type": "Class",
    "id": "c.dessert-wine",
    "name": "DessertWine",
    "description": "Sweet wine served with or as dessert.",
    "fixedValues": {
      "s.sugar": "sweet"
    }
  },
  {
    "type": "Class",
    "id": "c.bordeaux",
    "name": "Bordeaux",
    "description": "Red wine from the Bordeaux region of France.",
    "terminological": true
  },
  {
    "type": "Class",
    "id": "c.medoc",
    "name": "Medoc",
    "description": "Bordeaux from the Médoc sub-region.",
    "terminological": true
  },
  {
    "type": "Class",
    "id": "c.pauillac",
    "name": "Pauillac",
    "description": "Médoc wine from the Pauillac appellation.",
    "terminological": true
  },
  {
    "type": "Class",
    "id": "c.margaux",
    "name": "Margaux",
    "description": "Médoc wine from the Margaux appellation.",
    "terminological": true
  },
  {
    "type": "Class",
    "id": "c.beaujolais",
    "name": "Beaujolais",
    "description": "Light red wine from the Beaujolais region, made from Gamay.",
    "terminological": true
  },
  {
    "type": "Class",
    "id": "c.merlot",
    "name": "Merlot",
    "description": "Red wine made from the Merlot grape."
  },
  {
    "type": "Class",
    "id": "c.port",
    "name": "Port",
    "description": "Fortified sweet red wine from Portugal. (Only red Ports are modeled, as in the paper.)"
  },
  {
    "type": "Class",
    "id": "c.chardonnay",
    "name": "Chardonnay",
    "description": "White wine made from the Chardonnay grape."
  },
  {
    "type": "Class",
    "id": "c.riesling",
    "name": "Riesling",
    "description": "White wine made from the Riesling grape."
  },
  {
    "type": "Class",
    "id": "c.sauternes",
    "name": "Sauternes",
    "description": "Sweet white wine from the Sauternes area of Bordeaux."
  },
  {
    "type": "DesignDecision",
    "id": "d.2",
    "title": "Sauternes keeps its final s",
    "decision": "The class is named Sauternes, not Sauterne.",
    "rationale": "It's the proper name of the appellation, not a plural.",
    "metaRules": [
      "naming-singular-plural-consistent"
    ],
    "date": "2026-09-23"
  },
  {
    "type": "Class",
    "id": "c.winery",
    "name": "Winery",
    "description": "A business that makes wine."
  },
  {
    "type": "Class",
    "id": "c.wine-grape",
    "name": "WineGrape",
    "description": "A grape variety used to make wine.",
    "synonyms": [
      "Varietal"
    ]
  },
  {
    "type": "Class",
    "id": "c.wine-region",
    "name": "WineRegion",
    "description": "A geographic area wines are named after or come from."
  },
  {
    "type": "Class",
    "id": "c.food",
    "name": "Food",
    "description": "A kind of dish or ingredient a wine can be paired with.",
    "abstract": true
  },
  {
    "type": "Class",
    "id": "c.seafood",
    "name": "Seafood",
    "description": "Fish and shellfish dishes."
  },
  {
    "type": "Class",
    "id": "c.red-meat",
    "name": "RedMeat",
    "description": "Beef, lamb and similar dishes, including grilled meat."
  },
  {
    "type": "DesignDecision",
    "id": "d.3",
    "title": "Regional wines are terminological classes",
    "decision": "Bordeaux, Medoc, Pauillac, Margaux and Beaujolais are classes even though they add no slots of their own.",
    "rationale": "Sommeliers and diners always distinguish these appellations (Ontology 101 §4.4: distinctions experts commonly make).",
    "metaRules": [
      "hier-single-child"
    ],
    "date": "2026-09-23"
  },
  {
    "type": "Slot",
    "id": "s.color",
    "name": "color",
    "valueType": "Enumerated",
    "allowedValues": [
      "red",
      "white",
      "rose"
    ],
    "cardinality": "single",
    "description": "The wine's color."
  },
  {
    "type": "Slot",
    "id": "s.body",
    "name": "body",
    "valueType": "Enumerated",
    "allowedValues": [
      "light",
      "medium",
      "full"
    ],
    "cardinality": "single",
    "description": "How heavy the wine feels in the mouth."
  },
  {
    "type": "Slot",
    "id": "s.flavor",
    "name": "flavor",
    "valueType": "Enumerated",
    "allowedValues": [
      "delicate",
      "moderate",
      "strong"
    ],
    "cardinality": "single",
    "description": "Intensity of the wine's flavor."
  },
  {
    "type": "Slot",
    "id": "s.sugar",
    "name": "sugar",
    "valueType": "Enumerated",
    "allowedValues": [
      "dry",
      "offDry",
      "sweet"
    ],
    "cardinality": "single",
    "description": "Residual sweetness."
  },
  {
    "type": "Slot",
    "id": "s.tannin-level",
    "name": "tanninLevel",
    "valueType": "Enumerated",
    "allowedValues": [
      "low",
      "moderate",
      "high"
    ],
    "cardinality": "single",
    "description": "Astringency from grape skins; only meaningful for red wines."
  },
  {
    "type": "Slot",
    "id": "s.maker",
    "name": "maker",
    "valueType": "Instance",
    "relType": "MAKER",
    "cardinality": "single",
    "minCardinality": 1,
    "description": "The winery that produced the wine."
  },
  {
    "type": "Slot",
    "id": "s.produces",
    "name": "produces",
    "valueType": "Instance",
    "relType": "PRODUCES",
    "cardinality": "multiple",
    "description": "Wines the winery makes."
  },
  {
    "type": "Slot",
    "id": "s.grape",
    "name": "grape",
    "valueType": "Instance",
    "relType": "GRAPE",
    "cardinality": "multiple",
    "minCardinality": 1,
    "description": "Grape varieties the wine is made from."
  },
  {
    "type": "Slot",
    "id": "s.region",
    "name": "region",
    "valueType": "Instance",
    "relType": "REGION",
    "cardinality": "single",
    "description": "Where the wine comes from."
  },
  {
    "type": "Slot",
    "id": "s.location",
    "name": "location",
    "valueType": "String",
    "cardinality": "single",
    "description": "Where the winery is."
  },
  {
    "type": "Slot",
    "id": "s.goes-well-with",
    "name": "goesWellWith",
    "valueType": "Instance",
    "relType": "GOES_WELL_WITH",
    "cardinality": "multiple",
    "description": "Foods this wine pairs well with.",
    "edgeProperties": [
      {
        "name": "strength",
        "valueType": "Enumerated",
        "allowedValues": [
          "classic",
          "good"
        ]
      }
    ]
  },
