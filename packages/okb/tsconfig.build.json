{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "stripInternal": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    "paths": {
      "@ontology-kit/format": [
        "../format/types-internal/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/gendocs.ts"
  ]
}
