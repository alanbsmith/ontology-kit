    {
      "id": "d.8wg5vc",
      "type": "DesignDecision",
      "createdAt": "2026-09-23T00:00:02Z",
      "date": "2026-09-23",
      "decision": "Bordeaux, Medoc, Pauillac, Margaux and Beaujolais are classes even though they add no slots of their own.",
      "metaRules": [
        "hier-single-child"
      ],
      "rationale": "Sommeliers and diners always distinguish these appellations (Ontology 101 §4.4: distinctions experts commonly make).",
      "title": "Regional wines are terminological classes",
      "updatedAt": "2026-09-23T00:00:02Z"
    },
    {
      "id": "d.386rne",
      "type": "DesignDecision",
      "createdAt": "2026-09-23T00:00:01Z",
      "date": "2026-09-23",
      "decision": "The class is named Sauternes, not Sauterne.",
      "metaRules": [
        "naming-singular-plural-consistent"
      ],
      "rationale": "It's the proper name of the appellation, not a plural.",
      "title": "Sauternes keeps its final s",
      "updatedAt": "2026-09-23T00:00:01Z"
    },
    {
      "id": "d.h6nzmn",
      "type": "DesignDecision",
      "createdAt": "2026-09-23T00:00:00Z",
      "date": "2026-09-23",
      "decision": "Build from scratch.",
      "rationale": "Following Ontology 101, which builds the wine ontology from scratch for teaching; a French-wine knowledge base or retailer vocabulary would be candidates in a real project.",
      "title": "No existing ontology reused",
      "updatedAt": "2026-09-23T00:00:00Z"
    },
