{
  "name": "@ontology-kit/format",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Read the okb file format: an ontology folder's typed nodes and edges, loading with migrations, the reserved edge types and relationship values. No CLI, no meta-KB.",
  "homepage": "https://ontology-kit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanbsmith/ontology-kit.git",
    "directory": "packages/format"
  },
  "bugs": {
    "url": "https://github.com/alanbsmith/ontology-kit/issues"
  },
  "keywords": [
    "ontology",
    "knowledge-graph",
    "knowledge-base",
    "labeled-property-graph",
    "file-format",
    "okb"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test \"tests/*.test.ts\"",
    "build": "rm -rf dist types-internal && tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts.ts && tsc -p tsconfig.internal.json && node ../../scripts/rewrite-dts.ts types-internal",
    "prepack": "npm run build",
    "prepublishOnly": "node ../../scripts/publish-guard.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0"
  }
}
